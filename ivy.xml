<?xml version="1.0" encoding="UTF-8"?>
<ivy-module version="2.0"
            xmlns:m="http://ant.apache.org/ivy/maven">
    <info organisation="lab3" module="lab3"/>

    <configurations>
        <conf name="default"/>
        <conf name="runtime" extends="default"/>
        <conf name="provided" extends="default"/>
        <conf name="test" extends="default"/>
    </configurations>

    <dependencies>
        <!-- Jakarta EE API (предоставляется сервером приложений) -->
        <dependency org="jakarta.platform" name="jakarta.jakartaee-web-api" rev="9.0.0" conf="provided->default"/>

        <!-- PrimeFaces с classifier 'jakarta' -->
        <dependency org="org.primefaces" name="primefaces" rev="14.0.6" conf="runtime->default">
            <artifact name="primefaces" type="jar" ext="jar" m:classifier="jakarta"/>
        </dependency>

        <!-- Остальные зависимости -->
        <dependency org="org.primefaces.themes" name="all-themes" rev="1.1.0" conf="runtime->default"/>
        <dependency org="org.webjars.npm" name="primeflex" rev="3.3.1" conf="runtime->default"/>
        <dependency org="org.webjars.npm" name="primeicons" rev="7.0.0" conf="runtime->default"/>
        <dependency org="org.hibernate" name="hibernate-core" rev="6.6.1.Final" conf="runtime->default"/>
        <dependency org="org.postgresql" name="postgresql" rev="42.7.4" conf="runtime->default"/>
        <dependency org="ch.qos.logback" name="logback-classic" rev="1.3.12" conf="runtime->default"/>

        <!-- Lombok (только на этапе компиляции) -->
        <dependency org="org.projectlombok" name="lombok" rev="1.18.34" conf="provided->default"/>

        <!-- JUnit 5 -->
        <dependency org="org.junit.jupiter" name="junit-jupiter" rev="5.10.0" conf="test->default"/>
        <dependency org="org.junit" name="junit-bom" rev="5.10.0" conf="test->default"/>
    </dependencies>
</ivy-module>