<?xml version="1.0" encoding="UTF-8"?>
<project name="lab3" basedir="." default="build">

    <property file="project.properties"/>
    <property file="secret.properties"/>

    <path id="compile.classpath">
        <fileset dir="${lib}" includes="**/*.jar"/>
    </path>

    <path id="test.classpath">
        <path refid="compile.classpath"/>
        <fileset dir="${lib}">
            <include name="junit-jupiter-api-${junit.version}.jar"/>
            <include name="junit-jupiter-engine-${junit.version}.jar"/>
            <include name="junit-platform-commons-${junit.platform.version}.jar"/>
            <include name="junit-platform-engine-${junit.platform.version}.jar"/>
            <include name="junit-platform-console-standalone-${junit.platform.version}.jar"/>
            <include name="apiguardian-api-1.1.2.jar"/>
            <include name="opentest4j-1.2.0.jar"/>
        </fileset>
        <pathelement location="${dir.build}/classes"/>
        <pathelement location="${dir.build}/test-classes"/>
    </path>

    <target name="download-test-libs">
        <mkdir dir="${lib}"/>
        <get src="https://repo1.maven.org/maven2/org/junit/jupiter/junit-jupiter-api/${junit.version}/junit-jupiter-api-${junit.version}.jar"
             dest="${lib}" verbose="true"/>
        <get src="https://repo1.maven.org/maven2/org/junit/jupiter/junit-jupiter-engine/${junit.version}/junit-jupiter-engine-${junit.version}.jar"
             dest="${lib}" verbose="true"/>
        <get src="https://repo1.maven.org/maven2/org/junit/platform/junit-platform-commons/${junit.platform.version}/junit-platform-commons-${junit.platform.version}.jar"
             dest="${lib}" verbose="true"/>
        <get src="https://repo1.maven.org/maven2/org/junit/platform/junit-platform-engine/${junit.platform.version}/junit-platform-engine-${junit.platform.version}.jar"
             dest="${lib}" verbose="true"/>
        <get src="https://repo1.maven.org/maven2/org/junit/platform/junit-platform-console-standalone/${junit.platform.version}/junit-platform-console-standalone-${junit.platform.version}.jar"
             dest="${lib}" verbose="true"/>
        <get src="https://repo1.maven.org/maven2/org/apiguardian/apiguardian-api/1.1.2/apiguardian-api-1.1.2.jar"
             dest="${lib}" verbose="true"/>
        <get src="https://repo1.maven.org/maven2/org/opentest4j/opentest4j/1.2.0/opentest4j-1.2.0.jar"
             dest="${lib}" verbose="true"/>
    </target>

    <target name="test" depends="download-test-libs" description="Run JUnit 5 tests">
        <mkdir dir="${dir.build}/test-classes"/>
        <mkdir dir="${dir.build.test-reports}"/>

        <!-- Компиляция тестов -->
        <javac srcdir="${src.test.java}"
               destdir="${dir.build}/test-classes"
               includeantruntime="false"
               classpathref="test.classpath"
               release="17"/>

        <!-- Проверка classpath перед запуском -->
        <pathconvert property="test.classpath.string" refid="test.classpath"/>
        <echo message="Test Classpath: ${test.classpath.string}"/>

        <!-- Запуск тестов через ConsoleLauncher -->
        <java classname="org.junit.platform.console.ConsoleLauncher"
              classpathref="test.classpath"
              fork="true"
              failonerror="true">
            <arg value="--class-path"/>
            <arg path="${dir.build}/test-classes:${dir.build}/classes"/>
            <arg value="--scan-class-path"/>
            <arg value="--include-classname"/>
            <arg value=".*Test"/>
            <arg value="--reports-dir"/>
            <arg path="${dir.build.test-reports}"/>
        </java>
    </target>

    <target name="scp" description="Перемещение собранного проекта по SCP">
        <scp file="${file.war}"
             todir="${scp.username}@${scp.host}:${scp.remotedir}"
             port="${scp.port}"
             password="${scp.password}"
             trust="true"
             verbose="true"/>
    </target>

    <target name="download-deps">
        <mkdir dir="${lib}/temp"/>
        <get src="https://repo1.maven.org/maven2/jakarta/platform/jakarta.jakartaee-web-api/9.0.0/jakarta.jakartaee-web-api-9.0.0.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/org/antlr/antlr4-runtime/4.13.0/antlr4-runtime-4.13.0.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/org/primefaces/primefaces/14.0.6/primefaces-14.0.6-jakarta.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/org/primefaces/themes/all-themes/1.1.0/all-themes-1.1.0.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/org/webjars/npm/primeflex/3.3.1/primeflex-3.3.1.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/org/webjars/npm/primeicons/7.0.0/primeicons-7.0.0.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/org/hibernate/orm/hibernate-core/6.6.1.Final/hibernate-core-6.6.1.Final.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true" ignoreerrors="true"/>
        <get src="https://repo1.maven.org/maven2/org/jboss/logging/jboss-logging/3.5.3.Final/jboss-logging-3.5.3.Final.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/jakarta/persistence/jakarta.persistence-api/3.1.0/jakarta.persistence-api-3.1.0.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/org/hibernate/common/hibernate-commons-annotations/6.0.6.Final/hibernate-commons-annotations-6.0.6.Final.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/net/bytebuddy/byte-buddy/1.14.11/byte-buddy-1.14.11.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/org/jboss/spec/javax/transaction/jboss-transaction-api_1.3_spec/2.0.0.Final/jboss-transaction-api_1.3_spec-2.0.0.Final.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/com/fasterxml/classmate/1.5.1/classmate-1.5.1.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.4/postgresql-42.7.4.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/ch/qos/logback/logback-classic/1.3.12/logback-classic-1.3.12.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/ch/qos/logback/logback-core/1.3.12/logback-core-1.3.12.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/org/slf4j/slf4j-api/2.0.9/slf4j-api-2.0.9.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/org/projectlombok/lombok/1.18.34/lombok-1.18.34.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/org/apiguardian/apiguardian-api/1.1.2/apiguardian-api-1.1.2.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/com/jcraft/jsch/0.1.54/jsch-0.1.54.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/org/apache/ant/ant-jsch/1.10.14/ant-jsch-1.10.14.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <get src="https://repo1.maven.org/maven2/org/slf4j/slf4j-simple/2.0.9/slf4j-simple-2.0.9.jar"
             dest="${lib}/temp" verbose="true" usetimestamp="true"/>
        <copy todir="${lib}">
            <fileset dir="${lib}/temp"/>
        </copy>
        <delete dir="${lib}/temp"/>
    </target>

    <target name="compile">
        <mkdir dir="${dir.build.classes}"/>

        <javac srcdir="${src.main.java}"
               destdir="${dir.build.classes}"
               includeantruntime="false"
               source="17"
               target="17"
               encoding="UTF-8"
               debug="true"
               fork="true"
               executable="${javac.executable}">
            <classpath refid="compile.classpath"/>
            <compilerarg line="-Xlint:unchecked -parameters"/>
        </javac>

        <copy todir="${dir.build.classes}" preservelastmodified="true">
            <fileset dir="${src.main.resources}" includes="**/*" excludes="**/*.java"/>
        </copy>

        <mkdir dir="${dir.build.classes}/META-INF"/>
        <manifest file="${dir.build}/META-INF/MANIFEST.MF" mode="update">
            <attribute name="Manifest-Version" value="1.0.0"/>
            <attribute name="Implementation-Version" value="1.0.0"/>
        </manifest>
    </target>

    <target name="native2ascii" description="Converting localization files">
        <delete dir="${dir.build.resources}/resources-native"/>
        <mkdir dir="${dir.build.resources}/resources-native"/>

        <native2ascii src="${src.main.resources}"
                      dest="${dir.build.resources}/resources-native"
                      includes="**/*.properties"
                      encoding="ISO-8859-1"
                      reverse="false"/>

        <copy todir="${dir.build.classes}" preservelastmodified="true">
            <fileset dir="${dir.build.resources}/resources-native" includes="**/*.properties"/>
        </copy>
    </target>

    <target name="build" depends="compile,native2ascii">
        <war destfile="${file.war}"
             webxml="${src.main.webapp}/WEB-INF/web.xml"
             needxmlfile="false">
            <fileset dir="${src.main.webapp}" excludes="WEB-INF/web.xml"/>
            <lib dir="${lib}" excludes="**/*.properties"/>
            <classes dir="${dir.build.classes}" excludes="**/package-info.class"/>
            <metainf dir="${dir.build.classes}/META-INF"/>
        </war>
        <antcall target="music"/>
    </target>

    <target name="clean">
        <delete dir="ant"/>
        <delete dir="lib"/>
    </target>

    <target name="music" description="Play music when build is complete">
        <condition property="isWindows">
            <os family="windows"/>
        </condition>
        <condition property="isMac">
            <os family="mac"/>
        </condition>

        <exec executable="cmd" osfamily="windows" failonerror="false">
            <arg value="/c"/>
            <arg value="start"/>
            <arg value="/B"/>
            <arg value="${file.music}"/>
        </exec>

        <exec executable="/bin/sh" osfamily="mac" failonerror="false">
            <arg value="-c"/>
            <arg value="afplay '${file.music}' &amp;"/>
        </exec>
    </target>

    <target name="doc" description="Добавление MD5 и SHA-1, генерация javadoc">
        <checksum file="${file.war}" property="war.md5" algorithm="MD5"/>
        <checksum file="${file.war}" property="war.sha1" algorithm="SHA-1"/>
        <mkdir dir="${dir.build}/META-INF"/>
        <manifest file="${dir.build}/META-INF/MANIFEST.MF" mode="update">
            <attribute name="MD5" value="${war.md5}"/>
            <attribute name="SHA-1" value="${war.sha1}"/>
        </manifest>
        <war destfile="${file.war}" update="true">
            <metainf dir="${dir.build}/META-INF"/>
        </war>
        <mkdir dir="${dir.build}/javadoc"/>
        <javadoc destdir="${dir.build}/javadoc"
                 sourcepath="${src.main.java}"
                 classpathref="compile.classpath"
                 packagenames="*"
                 use="true"
                 author="true"
                 version="true"
                 doctitle="Lab3 API">
        </javadoc>
        <jar destfile="${file.war}" update="true">
            <fileset dir="${dir.build}/javadoc"/>
        </jar>
    </target>

    <target name="env" description="Deploy to WildFly and run">
        <!-- POSTGRES -->
        <available property="docker.exists" file="${docker.home}"/>
        <fail unless="docker.exists" message="Docker not found at ${docker.home}"/>

        <exec executable="docker-compose" dir="${basedir}" failonerror="false">
            <arg value="down"/>
        </exec>

        <exec executable="docker-compose" dir="${basedir}" failonerror="true">
            <arg value="up"/>
            <arg value="-d"/>
        </exec>

        <exec executable="docker" dir="${basedir}" failonerror="true">
            <arg value="inspect"/>
            <arg value="-f"/>
            <arg value="{{.State.Running}}"/>
            <arg value="lab3-postgres"/>
        </exec>

        <!-- WILDFLY -->
        <available property="wildfly.exists" file="${wildfly.home}"/>
        <fail unless="wildfly.exists"
              message="WildFly not found at ${wildfly.home}. Please set correct wildfly.home in properties"/>

        <exec executable="${wildfly.home}/bin/jboss-cli.sh" osfamily="unix" failonerror="false">
            <arg value="--connect"/>
            <arg value="command=:shutdown"/>
        </exec>
        <sleep seconds="3"/>

        <copy file="${file.war}"
              tofile="${wildfly.deployment}/${name.project.bin}"
              overwrite="true"/>

        <exec executable="${wildfly.home}/bin/standalone.sh" spawn="true">
            <arg value="-b"/>
            <arg value="0.0.0.0"/>
            <env key="JAVA_HOME" value="${java.home}"/>
        </exec>

        <waitfor maxwait="30" maxwaitunit="second">
            <http url="http://localhost:8080/"/>
        </waitfor>

        <exec executable="open" osfamily="mac">
            <arg value="http://localhost:8080/${name.project}"/>
        </exec>
        <exec executable="xdg-open" osfamily="unix" os="linux" failonerror="false">
            <arg value="http://localhost:8080/${name.project}"/>
        </exec>
        <exec executable="cmd" osfamily="windows" failonerror="false">
            <arg value="/c"/>
            <arg value="start"/>
            <arg value="http://localhost:8080/${name.project}"/>
        </exec>
    </target>

    <target name="env-stop" depends="init-antcontrib" description="Stop WildFly and Docker containers">
        <!-- Остановка WildFly -->
        <available property="wildfly.exists" file="${wildfly.home}"/>
        <if>
            <isset property="wildfly.exists"/>
            <then>
                <echo message="Stopping WildFly server..."/>
                <exec executable="${wildfly.home}/bin/jboss-cli.sh" osfamily="unix" failonerror="false">
                    <arg value="--connect"/>
                    <arg value="command=:shutdown"/>
                </exec>
                <echo message="WildFly server stopped"/>
            </then>
            <else>
                <echo message="WildFly not found at ${wildfly.home}, skipping..."/>
            </else>
        </if>

        <!-- Остановка Docker -->
        <available property="docker.exists" file="${docker.home}"/>
        <if>
            <isset property="docker.exists"/>
            <then>
                <echo message="Stopping Docker containers..."/>
                <exec executable="docker-compose" dir="${basedir}" failonerror="false">
                    <arg value="down"/>
                </exec>
                <echo message="Docker containers stopped and removed"/>
            </then>
            <else>
                <echo message="Docker not found at ${docker.home}, skipping..."/>
            </else>
        </if>

        <!-- Дополнительная проверка процессов -->
        <exec executable="pkill" osfamily="unix" failonerror="false">
            <arg value="-f"/>
            <arg value="standalone.sh"/>
        </exec>
    </target>

    <fileset id="areabean.fileset" dir="${dir.build.alt.src}">
        <include name="**/AreaBean.java"/>
    </fileset>
    <target name="alt" description="Create alternative version in build/alt directory">
        <delete dir="${dir.build.alt}"/>
        <mkdir dir="${dir.build.alt}"/>
        <mkdir dir="${dir.build.alt.src}"/>
        <mkdir dir="${dir.build.alt.web}"/>
        <mkdir dir="${dir.build.alt.classes}"/>
        <mkdir dir="${dir.build.alt.lib}"/>

        <copy todir="${dir.build.alt.src}">
            <fileset dir="${src.main.java}"/>
        </copy>
        <copy todir="${dir.build.alt.web}">
            <fileset dir="${src.main.webapp}"/>
        </copy>

        <copy todir="${dir.build.alt.lib}">
            <fileset dir="${lib}"/>
        </copy>

        <fileset id="rename.files" dir="${dir.build.alt.src}">
            <include name="**/*.java"/>
            <include name="**/*.properties"/>
            <include name="**/*.xml"/>
        </fileset>
        <pathconvert property="files.to.rename" refid="rename.files" pathsep=","/>

        <replaceregexp flags="g" match="${replace.regex.oldName}" replace="${replace.regex.newName}">
            <fileset dir="${dir.build.alt.src}">
                <include name="**/*.java"/>
                <include name="**/*.properties"/>
                <include name="**/*.xml"/>
            </fileset>
            <fileset dir="${dir.build.alt.web}">
                <include name="**/*.jsp"/>
                <include name="**/*.html"/>
                <include name="**/*.xml"/>
            </fileset>
        </replaceregexp>

        <move todir="${dir.build.alt.src}">
            <fileset dir="${dir.build.alt.src}" includes="**/${replace.regex.oldName}.java"/>
            <mapper type="regexp" from="^(.*)${replace.regex.oldName}(.*)$$" to="\1${replace.regex.newName}\2"/>
        </move>

        <javac srcdir="${dir.build.alt.src}"
               destdir="${dir.build.alt.classes}"
               includeantruntime="false"
               classpathref="compile.classpath"
               release="17">
            <classpath>
                <fileset dir="${dir.build.alt.lib}" includes="**/*.jar"/>
            </classpath>
        </javac>

        <copy todir="${dir.build.alt.classes}">
            <fileset dir="${src.main.resources}" excludes="**/*.java"/>
        </copy>

        <war destfile="${file.alt.war}"
             webxml="${dir.build.alt.web}/WEB-INF/web.xml"
             needxmlfile="false">
            <classes dir="${dir.build.alt.classes}"/>
            <lib dir="${dir.build.alt.lib}"/>
            <fileset dir="${dir.build.alt.web}" excludes="WEB-INF/web.xml"/>
        </war>
    </target>

    <target name="init-antcontrib">
        <!-- <mkdir dir="lib"/>-->
        <get src="https://repo1.maven.org/maven2/ant-contrib/ant-contrib/1.0b3/ant-contrib-1.0b3.jar"
             dest="lib/ant-contrib-1.0b3.jar"
             verbose="true"
             usetimestamp="true"/>
        <taskdef resource="net/sf/antcontrib/antlib.xml"
                 classpath="lib/ant-contrib-1.0b3.jar"/>
    </target>

    <target name="diff" depends="init-antcontrib" description="Check changes and commit to feature branch">

        <exec executable="git" outputproperty="git.diff.files">
            <arg value="diff"/>
            <arg value="--name-only"/>
            <arg value="HEAD"/>
        </exec>
        <echo message="Changed files: ${git.diff.files}"/>

        <condition property="critical.changes.detected">
            <contains string="${git.diff.files}" substring="${diff.critical.classes}"/>
        </condition>

        <if>
            <isset property="critical.changes.detected"/>
            <then>
                <echo message="Changes affect critical classes. Commit skipped."/>
            </then>
            <else>
                <echo message="No critical changes detected. Performing commit..."/>

                <tstamp>
                    <format property="commit.time" pattern="yyyy-MM-dd HH:mm:ss"/>
                </tstamp>

                <exec executable="git" failonerror="true">
                    <arg value="commit"/>
                    <arg value="-a"/>
                    <arg value="-m"/>
                    <arg value="Auto-commit at ${commit.time}"/>
                </exec>

            </else>
        </if>

        <!-- Return to original branch -->
        <exec executable="git" failonerror="false">
            <arg value="checkout"/>
            <arg value="-"/>
        </exec>
    </target>

    <target name="history" depends="init-antcontrib" description="Roll back through history until successful build">
        <!-- Инициализация свойств -->
        <property name="build.success" value="false"/>
        <property name="max.attempts" value="2"/>
        <property name="history.file" value="${dir.build}/history_diff.txt"/>

        <!-- Создаем файл для хранения истории -->
        <delete file="${history.file}"/>
        <touch file="${history.file}"/>

        <echo message="Starting historical build search..." level="info"/>

        <!-- Основной цикл проверки -->
        <for list="1,2" param="attempt" delimiter=",">
            <sequential>
                <if>
                    <equals arg1="${build.success}" arg2="false"/>
                    <then>
                        <echo message="Attempt: Trying to compile..."/>

                        <!-- Пробуем скомпилировать -->
                        <trycatch>
                            <try>
                                <antcall target="compile"/>
                                <property name="compile.failed" value="false"/>
                            </try>
                            <catch>
                                <property name="compile.failed" value="true"/>
                                <echo message="Compilation failed in attempt" level="warning"/>
                            </catch>
                        </trycatch>

                        <if>
                            <equals arg1="${compile.failed}" arg2="true"/>
                            <then>
                                <!-- Откатываемся на одну ревизию -->
                                <exec executable="git" failonerror="true">
                                    <arg value="reset"/>
                                    <arg value="--hard"/>
                                    <arg value="HEAD~1"/>
                                </exec>
                            </then>
                            <else>
                                <!-- Успешная компиляция -->
                                <property name="build.success" value="true"/>
                                <echo message="Successful build found!" level="info"/>

                                <!-- Получаем хэш текущей ревизии -->
                                <exec executable="git" outputproperty="current.revision">
                                    <arg value="rev-parse"/>
                                    <arg value="HEAD"/>
                                </exec>

                                <!-- Получаем diff с предыдущей ревизией -->
                                <exec executable="git" output="${history.file}">
                                    <arg value="show"/>
                                    <arg value="${current.revision}~1..${current.revision}"/>
                                </exec>

                                <echo message="Diff saved to ${history.file}" level="info"/>
                            </else>
                        </if>
                    </then>
                    <else>
                        <echo message="Build already succeeded - skipping remaining attempts" level="info"/>
                    </else>
                </if>
            </sequential>
        </for>

        <!-- Проверка, если ни одна ревизия не скомпилировалась -->
        <if>
            <equals arg1="${build.success}" arg2="false"/>
            <then>
                <echo message="No working revisions found in ${max.attempts} attempts!" level="error"/>
                <echo message="Project cannot be compiled in any recent revision"/>
            </then>
        </if>
    </target>

</project>